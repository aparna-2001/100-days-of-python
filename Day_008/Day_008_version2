#The caesar cipher

alphabet = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z']

direction = input("Type 'encode' to encrypt, type 'decode' to decrypt:\n").lower()
text = input("Type your message:\n").lower()
shift = int(input("Type the shift number:\n"))

def caesar(user_choice, original_text, shift_amount):

        def encrypt(original_text, shift_amount):
            cipher_text = ""
            other_characters = ""
            for letter in original_text:
                if letter not in alphabet:
                    other_characters += letter
                if letter in alphabet:
                    shifted_position = alphabet.index(letter) + shift_amount
                    shifted_position %= len(alphabet)
                    cipher_text += alphabet[shifted_position]
            print(f"Here is the encoded result: {cipher_text + other_characters}")

        def decrypt(original_text, shift_amount):
            output_text = ""
            other_characters = ""
            for letter in original_text:
                if letter not in alphabet:
                    other_characters += letter
                if letter in alphabet:
                    shifted_position = alphabet.index(letter) - shift_amount
                    shifted_position %= len(alphabet)
                    output_text += alphabet[shifted_position]
            print(f"here is the decoded result: {output_text + other_characters}")


        if user_choice == "encode":
            encrypt(original_text, shift_amount)
        elif user_choice == "decode":
            decrypt(original_text, shift_amount)
        else:
            print("invalid choice")

        restart = input("Do you want to restart the program? type 'y' for yes and 'n' for no\n").lower()
        if restart == "y":
            direction = input("Type 'encode' to encrypt, type 'decode' to decrypt:\n").lower()
            text = input("Type your message:\n").lower()
            shift = int(input("Type the shift number:\n"))
            caesar(user_choice=direction, original_text=text, shift_amount=shift)
        elif restart == "n":
            print("Good bye")
        else:
            print("invalid input")

caesar(user_choice=direction, original_text=text, shift_amount=shift)
